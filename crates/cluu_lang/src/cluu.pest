WS = _{ " " | "\t" }
NL = _{ "\r\n" | "\n" }
LINE_COMMENT = _{ "#" ~ (!NL ~ ANY)* }
ws0 = _{ (WS | LINE_COMMENT)* }

program = { SOI ~ ws0 ~ stmt_list? ~ ws0 ~ EOI }
subprogram = { stmt_list? }
// `&` is both a pipeline terminator (marks the preceding pipeline as bg) AND
// a statement separator — `sleep 30 & jobs` parses the same as
// `sleep 30 & ; jobs`. Achieved by lifting `&` out of `pipeline` and into
// `logical_sep`, and allowing multiple consecutive separators (so the legacy
// `& ;` form keeps working). When `bg_amp` appears in a separator chain the
// parser flags the *previous* pipeline as bg.
stmt_list = { stmt ~ (logical_sep+ ~ stmt)* ~ trailing_sep? }
// Connectors between statements. and_if / or_if are short-circuit logical
// operators evaluated by the executor; ; \n & are unconditional separators.
// `&&` must be tried before `&` so `cmd && next` is not eaten as `cmd & & next`.
logical_sep = { ws0 ~ (and_if | or_if | NL+ | ";" | bg_amp) ~ ws0 }
trailing_sep = _{ logical_sep+ }
and_if = { "&&" }
or_if  = { "||" }

stmt = _{ pipeline }
// `|` for pipe must NOT match the start of `||`.
pipeline = { command ~ (ws0 ~ pipe_op ~ ws0 ~ command)* }
pipe_op = _{ "|" ~ !("|") }
bg_amp = { "&" ~ !("&") }

// A command must have at least one part — either a prefix assignment or a
// cmd_item. Allowing the empty match used to be harmless because `pipeline`
// always consumed any trailing `&`, but now `&` is a between-statement
// separator so a trailing `&` would otherwise be followed by an empty
// pipeline ghost-stmt.
command = { (prefix_assign ~ (ws0 ~ prefix_assign)* ~ (ws0 ~ cmd_item ~ (ws0 ~ cmd_item)*)?) | (cmd_item ~ (ws0 ~ cmd_item)*) }
prefix_assign = { ident ~ "=" ~ word }
cmd_item = { redir | cmd_elem }
cmd_elem = { word | subshell }
subshell = { "(" ~ ws0 ~ subprogram ~ ws0 ~ ")" }

redir = { redir_op ~ ws0 ~ word }
redir_op = { ">>" | "2>" | ">" | "<" }

word = { word_part+ }
word_part = { single_quoted | double_quoted | var | cmdsub | bare }

var = { "$" ~ ident }
cmdsub = { "$(" ~ ws0 ~ subprogram ~ ws0 ~ ")" }

bare = { (bare_escape | bare_char)+ }
bare_escape = { "\\" ~ ANY }
bare_char = { !(WS | NL | ";" | "&" | "|" | ">" | "<" | "(" | ")" | "#" | "\"" | "'" | "$" | "\\") ~ ANY }

single_quoted = { "'" ~ single_inner* ~ "'" }
single_inner = { (!"'" ~ ANY) }

double_quoted = { "\"" ~ dq_part* ~ "\"" }
dq_part = { dq_escaped | dq_var | dq_cmdsub | dq_text }
dq_var = { "$" ~ ident }
dq_cmdsub = { "$(" ~ ws0 ~ subprogram ~ ws0 ~ ")" }
dq_escaped = { "\\" ~ ("\"" | "\\" | "$" | "n" | "t") }
dq_text = { (!"\"" ~ !"\\" ~ !"$" ~ ANY)+ }

ident = { (ASCII_ALPHANUMERIC | "_")+ }
