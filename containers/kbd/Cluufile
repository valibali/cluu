FROM driver
PROFILE ipc registry device
DRIVER bind bus=acpi hid=PNP0303
DRIVER tokens slot=10 rights=0x30000000
DRIVER source initrd_path="sys/kbd.elf"
PRELOAD
ENDPOINT listen
DEVICE irq
BUILD "cargo build --manifest-path userspace/kbd/Cargo.toml --target triplets/x86_64-cluu-user.json -Z build-std=core,alloc -Z build-std-features=compiler-builtins-mem" target/x86_64-cluu-user/debug/kbd.elf /bin/kbd
ENTRYPOINT /bin/kbd
RESTART always
