# Rust build artifacts
target/
**/*.rs.bk
*.pdb

# Cargo lock files (keep for workspace root, ignore in subdirectories)
**/Cargo.lock
!Cargo.lock

# Build outputs
*.o
*.a
*.so
*.elf
*.img
*.tar

# BOOTBOOT artifacts
/bootboot_image/bootboot.img

# Assembly build artifacts
/target/asm/
/target/initrd/
/target/initrd.tar
/target/cluu.img

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Debug
*.log
userfs/hello
userfs/bin/shell
userfs/bin/timeserver
userfs/bin/hello

# Ignore external folder except for patched config.sub
/external/*
!/external/newlib-*/
/external/newlib-*/*
!/external/newlib-*/config.sub
