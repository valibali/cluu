# CLUU external source package versions / refs.
# Keep these values as the single source of truth for upgrades.
# Source trees in external/ are downloaded on demand and are not tracked.

CLUU_NEWLIB_VERSION=4.4.0.20231231
CLUU_NEWLIB_URL=ftp://sourceware.org/pub/newlib/newlib-4.4.0.20231231.tar.gz
CLUU_NEWLIB_DIR=external/newlib-4.4.0.20231231

CLUU_MICROPYTHON_VERSION=v1.22.0
CLUU_MICROPYTHON_REPO=https://github.com/micropython/micropython.git
CLUU_MICROPYTHON_REF=v1.22.0
CLUU_MICROPYTHON_DIR=external/micropython

# Local patch metadata (used for audit warnings).
# newlib config.sub is patched to recognize the CLUU target triplet.
CLUU_NEWLIB_PATCH_FILES=config.sub
# Keep empty unless tracked MicroPython sources are intentionally patched.
CLUU_MICROPYTHON_PATCH_FILES=
